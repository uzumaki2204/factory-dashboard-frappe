{
  "doctype": "DocType",
  "name": "Productivity Dashboard Device Config",
  "module": "Factory Dashboard",
  "custom": 0,
  "autoname": "field:device",
  "allow_import": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "device", "label": "Factory Device", "fieldtype": "Link", "options": "Factory Device", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "display_mode", "label": "Display Mode", "fieldtype": "Select", "options": "single\ndual", "reqd": 1, "default": "single"},
    {"fieldname": "left_screen_section", "label": "Left Screen", "fieldtype": "Section Break", "description": "Select one production line or one line group for the left screen."},
    {"fieldname": "left_line", "label": "Production Line", "fieldtype": "Link", "options": "Production Line"},
    {"fieldname": "left_group", "label": "Line Group", "fieldtype": "Link", "options": "Line Group"},
    {"fieldname": "right_screen_section", "label": "Right Screen", "fieldtype": "Section Break", "description": "This selection is a backup in single mode and is used in dual mode."},
    {"fieldname": "right_line", "label": "Production Line", "fieldtype": "Link", "options": "Production Line"},
    {"fieldname": "right_group", "label": "Line Group", "fieldtype": "Link", "options": "Line Group"},
    {"fieldname": "updated_at", "label": "Updated At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "legacy_section", "label": "Legacy Configuration", "fieldtype": "Section Break", "hidden": 1},
    {"fieldname": "primary_line", "label": "Primary Line", "fieldtype": "Link", "options": "Production Line", "hidden": 1},
    {"fieldname": "secondary_line", "label": "Secondary Line", "fieldtype": "Link", "options": "Production Line", "hidden": 1},
    {"fieldname": "single_group", "label": "Single Group", "fieldtype": "Link", "options": "Line Group", "hidden": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "import": 1},
    {"role": "Productivity Dashboard Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "import": 1},
    {"role": "Productivity Viewer", "read": 1, "report": 1, "export": 1}
  ]
}
